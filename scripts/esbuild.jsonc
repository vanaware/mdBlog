{
  "$schema": "https://vanaware.github.io/buildit/schema/esbuild.json",
  "versionPaths": [
    "packages/mdblog/public/version.js",
    "packages/mdblog/src/version.ts"
  ],
  "forcepackagesversion": true,
  "targets": {
    "mdblog": {
      "default": true,
      "srcdir": "packages/mdblog/src",
      "distdir": "packages/server/build/dist",
      "clean": {
        "includes": ["*"]
      },
      "copyFiles": [
        {
          "basedir": "packages/mdblog/public"
        }
      ],
      "entryPoints": ["mod.ts"],
      "outfile": "mdblog.js",
      "platform": "browser",
      "format": "esm",
      "bundle": true,
      "minify": false,
      "sourcemap": "linked",
      "drop": ["debugger"],
      // "worker" além de "browser": o MESMO bundle é importado pelo Service Worker
      // (packages/mdblog/public/sw.js). Só com a condição "browser", o mapa de
      // exportações do pacote "decode-named-character-reference" resolve para
      // index.dom.js, que faz document.createElement no topo do módulo e faz
      // falhar a avaliação do script do SW ("ServiceWorker script evaluation
      // failed"). A precedência é a ordem das chaves do package.json, onde
      // "worker" vem antes de "browser", e nenhuma outra dependência tem uma
      // condição "worker", pelo que o código do browser fica inalterado.
      "conditions": ["browser", "worker"],
      "metafile": true,
      "write": true,
      "legalComments": "eof",
      "keepNames": true,
      "splitting": false,
      "banner": {
        "js": "/*!\n * mdBlog v__APP_VERSION__\n * (c) 2026 Vanaware - MIT License\n */\n"
      }
    },
    "dist": {
      "default": true,
      "srcdir": "packages/mdblog/src",
      "distdir": "packages/mdblog/dist",
      "clean": ["*"],
      "entryPoints": ["mod.ts"],
      "outfile": "mdblog.min.js",
      "platform": "browser",
      "format": "esm",
      "bundle": true,
      "minify": true,
      "sourcemap": "external",
      "drop": ["debugger"],
      "conditions": ["browser", "worker"],
      "metafile": false,
      "write": true,
      "legalComments": "eof",
      "keepNames": true,
      "splitting": false,
      "banner": {
        "js": "/*!\n * mdBlog v__APP_VERSION__\n * (c) 2026 Vanaware - MIT License\n */\n"
      }
    }
  }
}
